# Profile values are shell-sourced: keep JSON in single quotes.
# Example profile: the Zero State Spark box (Qwen3.5 vision served by SGLang).
# Copy to ~/.config/kubrick/vlm-spark.env and start with kubrick-vlm-spark
# (setup.sh proxy --profile tools/board_vision/profiles/spark.env.example --name spark).
# Owner-approved spend and data boundary (Danny, 2026-10-04).
KUBRICK_VLM_PROXY_ADDR=127.0.0.1:11435
KUBRICK_VLM_UPSTREAM_URL=https://qwen.zer0state.com/v1
# Spark serves one model; empty asks /v1/models for it.
KUBRICK_VLM_UPSTREAM_MODEL=
# The key stays outside the repo: SPARK_API_KEY, else this file (chmod 600).
KUBRICK_VLM_API_KEY_ENV=SPARK_API_KEY
KUBRICK_VLM_API_KEY_FILE=$HOME/.config/spark/api_key
# Cloudflare in front of Spark answers 403 to Python's default urllib User-Agent.
KUBRICK_VLM_EXTRA_HEADERS='{"User-Agent": "kubrick-vlm-proxy/1"}'
# Qwen3.5 thinks by default; the answer then lands in reasoning_content and is cut off.
KUBRICK_VLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
KUBRICK_VLM_MAX_TOKENS=64
KUBRICK_VLM_TIMEOUT=120
