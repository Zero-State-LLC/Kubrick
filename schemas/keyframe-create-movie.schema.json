{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubrick.zero-state.dev/schemas/keyframe-create-movie.schema.json",
  "title": "Keyframe create_movie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "brief",
    "aspectRatio",
    "targetDurationSeconds",
    "qualityPreset",
    "style",
    "shots"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "brief": {"type": "string", "minLength": 1},
    "aspectRatio": {"type": "string", "minLength": 1},
    "targetDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "qualityPreset": {"enum": ["draft", "standard", "high"]},
    "style": {"type": "string", "minLength": 1},
    "referenceImages": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "title", "imagePrompt", "videoPrompt", "durationSeconds", "audio"],
        "properties": {
          "scene": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "imagePrompt": {"type": "string", "minLength": 1},
          "videoPrompt": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "minimum": 3, "maximum": 60},
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sound"],
            "properties": {
              "sound": {"type": "string", "minLength": 1},
              "speech": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "lines"],
                "properties": {
                  "mode": {"const": "native"},
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
