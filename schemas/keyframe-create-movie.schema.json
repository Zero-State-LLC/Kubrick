{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubrick.zero-state.dev/schemas/keyframe-create-movie.schema.json",
  "title": "Keyframe create_movie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "brief",
    "aspectRatio",
    "targetDurationSeconds",
    "qualityPreset",
    "style",
    "shots"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "brief": {"type": "string", "minLength": 1},
    "aspectRatio": {"type": "string", "minLength": 1},
    "targetDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "plannedDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
    "qualityPreset": {"enum": ["draft", "standard", "high"]},
    "style": {"type": "string", "minLength": 1},
    "referenceImages": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "dropped_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot", "references", "reason"],
        "properties": {
          "shot": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "cut_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot", "source_in", "source_out", "planned_seconds", "generated_seconds"],
        "properties": {
          "shot": {"type": "string"},
          "source_in": {"type": "number"},
          "source_out": {"type": "number"},
          "planned_seconds": {"type": "number"},
          "generated_seconds": {"type": "number"}
        }
      }
    },
    "prep_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "shot", "message", "recommendation"],
        "properties": {
          "code": {"type": "string"},
          "shot": {"type": ["string", "null"]},
          "character": {"type": "string"},
          "message": {"type": "string"},
          "recommendation": {"type": "string"},
          "evidence": {"type": "string"},
          "observed_on": {"type": "string"}
        }
      }
    },
    "lock_carriers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot", "lock", "kind", "carrier"],
        "properties": {
          "shot": {"type": "string"},
          "lock": {"type": "string"},
          "kind": {"type": "string"},
          "carrier": {"type": "string"},
          "critical": {"type": "boolean"}
        }
      }
    },
    "spend_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status", "shots", "total_credits"],
      "properties": {
        "label": {"const": "INFERRED"},
        "status": {"enum": ["INFERRED", "NOT_COMPUTABLE"]},
        "unit": {"type": ["string", "null"]},
        "resolution": {"type": ["string", "null"]},
        "rate": {"type": ["number", "null"]},
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shot", "generated_seconds", "credits"],
            "properties": {
              "shot": {"type": "string"},
              "generated_seconds": {"type": "number"},
              "credits": {"type": ["number", "null"]}
            }
          }
        },
        "total_credits": {"type": ["number", "null"]}
      }
    },
    "execution_checklist": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "multi_shot_prompt": {"type": "string", "minLength": 1},
    "technique_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "shot", "intent", "prompt_template", "trim_guidance", "applied", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "shot": {"type": "string"},
          "intent": {"type": "string"},
          "prompt_template": {"type": "string"},
          "trim_guidance": {"type": "string"},
          "applied": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": {"type": "string"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "title", "imagePrompt", "videoPrompt", "durationSeconds", "audio"],
        "properties": {
          "scene": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "imagePrompt": {"type": "string", "minLength": 1},
          "videoPrompt": {"type": "string", "minLength": 1},
          "durationSeconds": {"type": "number", "minimum": 4, "maximum": 30},
          "startImage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceFrame"],
            "properties": {
              "sourceFrame": {"type": "string", "minLength": 1},
              "atSeconds": {"type": "number"},
              "asset": {"type": "string", "minLength": 1}
            }
          },
          "referenceImages": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sound"],
            "properties": {
              "sound": {"type": "string", "minLength": 1},
              "speech": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "lines"],
                "properties": {
                  "mode": {"const": "native"},
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
