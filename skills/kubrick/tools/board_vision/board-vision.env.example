# Kubrick board image gate judge settings. Template with no secrets.
# setup.sh copies it to ~/.config/kubrick/board-vision.env if that file is absent.
# Use: source ~/.config/kubrick/board-vision.env before Kubrick spend commands.
#
# Lock judge: a loopback URL only (the gate refuses anything else). Point it at
# kubrick-vlm-proxy (any OpenAI-compatible vision endpoint, see profiles/) or
# at Ollama directly. If the judge is down every lock check is UNVERIFIED,
# which blocks spend (fail closed). Through the proxy the model name is a
# label only; the proxy profile chooses the upstream model.
export KUBRICK_BOARD_VLM_URL=http://127.0.0.1:11435
export KUBRICK_BOARD_VLM_MODEL=proxy-vision
#
# Local Ollama instead (CPU, weaker on EP-01): run kubrick-vlm start, then point
# KUBRICK_BOARD_VLM_URL at KUBRICK_OLLAMA_ADDR and KUBRICK_BOARD_VLM_MODEL at
# KUBRICK_OLLAMA_MODEL from ~/.config/kubrick/ollama.env.
#
# Identity check embedder (local, CPU, downloaded once by setup.sh).
export KUBRICK_BOARD_EMBED_MODEL=facebook/dinov2-small
