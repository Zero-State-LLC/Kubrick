# Profile values are shell-sourced: keep JSON in single quotes.
# Template profile for kubrick-vlm-proxy: any OpenAI-compatible vision endpoint.
# Copy to ~/.config/kubrick/vlm-proxy.env (or vlm-NAME.env for a launcher
# linked as kubrick-vlm-NAME) and fill in. No secrets in this file: point at
# the key with KUBRICK_VLM_API_KEY_ENV or KUBRICK_VLM_API_KEY_FILE.
KUBRICK_VLM_PROXY_ADDR=127.0.0.1:11435
# Base URL ending in /v1. A non-loopback upstream must be https.
KUBRICK_VLM_UPSTREAM_URL=https://vision.example.com/v1
# Optional. Empty means the first id from GET {upstream}/models.
KUBRICK_VLM_UPSTREAM_MODEL=
# Optional key source. Leave both empty for a local server with no auth.
KUBRICK_VLM_API_KEY_ENV=
KUBRICK_VLM_API_KEY_FILE=
# Optional JSON objects.
KUBRICK_VLM_EXTRA_HEADERS='{}'
KUBRICK_VLM_EXTRA_BODY='{}'
KUBRICK_VLM_MAX_TOKENS=64
KUBRICK_VLM_TIMEOUT=120
