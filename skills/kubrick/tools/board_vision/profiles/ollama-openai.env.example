# Profile values are shell-sourced: keep JSON in single quotes.
# Example profile: a local server with an OpenAI-compatible /v1 and no key
# (Ollama, llama.cpp server, vLLM, SGLang on this machine). The gate can also
# talk to Ollama directly with kubrick-vlm; this shows the proxy path.
KUBRICK_VLM_PROXY_ADDR=127.0.0.1:11436
KUBRICK_VLM_UPSTREAM_URL=http://127.0.0.1:11434/v1
KUBRICK_VLM_UPSTREAM_MODEL=qwen2.5vl:3b
KUBRICK_VLM_API_KEY_ENV=
KUBRICK_VLM_API_KEY_FILE=
KUBRICK_VLM_EXTRA_HEADERS='{}'
KUBRICK_VLM_EXTRA_BODY='{}'
KUBRICK_VLM_MAX_TOKENS=64
KUBRICK_VLM_TIMEOUT=300
