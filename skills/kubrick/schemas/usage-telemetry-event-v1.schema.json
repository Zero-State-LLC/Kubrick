{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubrick opt-in telemetry event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_day",
    "kubrick_version",
    "python_minor",
    "platform",
    "event_type",
    "intent",
    "action",
    "result",
    "reason_code",
    "duration_bucket",
    "pattern_id",
    "user_vote"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "kubrick_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "python_minor": {"type": "string", "pattern": "^3\\.[0-9]{1,2}$"},
    "platform": {"enum": ["linux", "macos", "windows", "other"]},
    "event_type": {"enum": ["usage", "quality_feedback"]},
    "intent": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "result": {"enum": ["success", "failure", "not_computable", null]},
    "reason_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z0-9_]{1,48}$"
    },
    "duration_bucket": {"enum": ["lt_100ms", "100_499ms", "500_1999ms", "2_10s", "gt_10s", null]},
    "pattern_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9_]{1,96}$"
    },
    "user_vote": {"enum": ["useful", "mixed", "not_useful", null]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"const": "quality_feedback"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "pattern_id": {"type": "string"},
          "user_vote": {"enum": ["useful", "mixed", "not_useful"]},
          "result": {"type": "null"},
          "reason_code": {"type": "null"},
          "duration_bucket": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "usage"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "pattern_id": {"type": "null"},
          "user_vote": {"type": "null"},
          "result": {"enum": ["success", "failure", "not_computable"]},
          "duration_bucket": {"enum": ["lt_100ms", "100_499ms", "500_1999ms", "2_10s", "gt_10s"]}
        }
      }
    }
  ]
}
