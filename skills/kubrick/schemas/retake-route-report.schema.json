{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubrick.zero-state.dev/schemas/retake-route-report.schema.json",
  "title": "Kubrick retake router (QC failure classifier) report",
  "description": "Output of kubrick.qc.edit_route.route. Recommendations only; nothing is submitted or written. Issues #104 and #92.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "authority", "routes", "drift_drafts", "corpus_write"],
  "properties": {
    "status": {"enum": ["PROPOSED", "NOT_COMPUTABLE"]},
    "authority": {"enum": ["PROPOSED", "NOT_COMPUTABLE"]},
    "corpus_write": {"const": false},
    "errors": {"type": "array", "items": {"type": "string"}},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot", "label", "action", "full_retake", "instruction"],
        "properties": {
          "shot": {"type": ["string", "null"]},
          "label": {
            "enum": [
              "LOCALIZED_MATERIAL", "LOCALIZED_LIGHT", "FRAMING", "MOTION_INFEASIBLE", "IDENTITY"
            ]
          },
          "action": {"enum": ["mask_edit", "reboard", "replan", "reference_fix"]},
          "full_retake": {"const": false},
          "instruction": {"type": "string", "minLength": 1},
          "provider": {"enum": ["aleph", "luma_modify", "wan_vace"]},
          "mask": {"const": "sam2_track"}
        }
      }
    },
    "drift_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code", "shot", "label", "status", "authority", "applied", "needs_human_approval"
        ],
        "properties": {
          "code": {"const": "AMBIGUOUS_ROUTE"},
          "shot": {"type": ["string", "null"]},
          "label": {"type": "string"},
          "status": {"const": "PROPOSED"},
          "authority": {"const": "PROPOSED"},
          "applied": {"const": false},
          "needs_human_approval": {"const": true},
          "drift_entry": {
            "description": "One known-drift entry; validated by drift-registry.schema.json",
            "type": "object"
          },
          "missing_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["trigger_kind", "model", "effect", "observed_on", "evidence"]}
          }
        },
        "oneOf": [{"required": ["drift_entry"]}, {"required": ["missing_fields"]}]
      }
    }
  }
}
