{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubrick.zero-state.dev/schemas/film-grammar.schema.json",
  "title": "Kubrick film grammar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "entries": {
      "type": "array",
      "minItems": 65,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "definition", "prompt_phrase", "conflicts", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "shot_size",
              "angle",
              "lens_band",
              "move",
              "lighting",
              "edit",
              "composition_9_16",
              "composition",
              "blocking",
              "camera_height",
              "continuity"
            ]
          },
          "definition": {"type": "string", "minLength": 1},
          "prompt_phrase": {"type": "string", "minLength": 1},
          "provider_notes": {"type": "string", "minLength": 1},
          "conflicts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "lens_mm_min": {"type": "number", "exclusiveMinimum": 0},
          "lens_mm_max": {"type": "number", "exclusiveMinimum": 0},
          "targets": {"$ref": "#/$defs/targets"}
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_ratio": {"$ref": "#/$defs/range"},
        "headroom_frac": {"$ref": "#/$defs/range"},
        "eye_y": {"$ref": "#/$defs/range"},
        "cx": {"$ref": "#/$defs/range"},
        "crop_margin": {"$ref": "#/$defs/range"},
        "lead_room_frac": {"$ref": "#/$defs/range"},
        "horizon_tilt_deg": {"$ref": "#/$defs/range"},
        "key_fill_stops": {"$ref": "#/$defs/range"},
        "delta_head_ratio": {"$ref": "#/$defs/range"},
        "eyeline_dy": {"$ref": "#/$defs/range"},
        "lens_mm": {"$ref": "#/$defs/range"},
        "min_motion_frac": {"$ref": "#/$defs/range"},
        "crop_landmark": {
          "enum": [
            "above_head", "chin", "shoulders_top", "mid_chest", "waist_above",
            "mid_thigh", "below_knee", "full_body", "wide"
          ]
        },
        "facing": {
          "enum": ["front", "3q_left", "3q_right", "profile_left", "profile_right", "back"]
        },
        "emitter_px_max": {"type": "integer", "minimum": 0}
      }
    }
  }
}
